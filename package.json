{
  "name": "sitewise",
  "version": "1.3.0",
  "description": "Give your AI agent the web: 50 sites as tools that return clean JSON, browser control, and a native MCP server. Also a CLI.",
  "author": "Mehal Srivastava",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/main.js",
  "bin": {
    "sitewise": "dist/main.js"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc --build --force && node -e \"require('fs').chmodSync('dist/main.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "claude",
    "cli",
    "web-scraping",
    "browser-automation",
    "json",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeHalogen/sitewise.git"
  },
  "homepage": "https://github.com/MeHalogen/sitewise#readme",
  "bugs": {
    "url": "https://github.com/MeHalogen/sitewise/issues"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@mozilla/readability": "^0.6.0",
    "commander": "^14.0.3",
    "fast-xml-parser": "^5.2.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^29.0.2",
    "picocolors": "^1.1.1",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.5.2",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.3",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  },
  "mcpName": "io.github.MeHalogen/sitewise"
}
